{
  "name": "betmas",
  "version": "1.0.0",
  "description": "BetMas - Exist-db application",
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-xquery": "^1.6.3"
  },
  "scripts": {
    "format:check": "prettier --check 'db/**/*.{xq,xql,xqm,xquery,js}'",
    "format:check:errors": "prettier --check --log-level error 'db/**/*.{xq,xql,xqm,xquery,js}'",
    "format:write": "prettier --write 'db/**/*.{xq,xql,xqm,xquery,js}'",
    "test:restore-users": "bats --tap test/restore-users-from-volume.bats",
    "test:app-image": "bats --tap test/app-image-expand.bats"
  }
}

