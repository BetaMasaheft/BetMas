<?xml version="1.0" encoding="UTF-8"?>
<project name="${package(version)}" default="xar">
    <xmlproperty file="expath-pkg.xml"/>
    <property name="project.version" value="${package(version)}"/>
    <property name="project.app" value="${package(abbrev)}"/>
    <property name="build.dir" value="build"/>
    <!-- Fetch the frontend libraries from npm into resources/{js,css,fonts}/external -->
    <target name="vendor">
        <exec executable="npm" failonerror="true">
            <arg value="install"/>
        </exec>
        <exec executable="npm" failonerror="true">
            <arg value="run"/>
            <arg value="vendor:copy"/>
        </exec>
    </target>
    <target name="xar" depends="vendor">
        <mkdir dir="${build.dir}"/>
        <zip basedir="." destfile="${build.dir}/${project.app}-${project.version}.xar"
             excludes="${build.dir}/**, scripts/**, node_modules/**, package.json, package-lock.json"/>
    </target>
</project>
